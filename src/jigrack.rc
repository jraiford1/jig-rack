#include <winver.h>
#include <winuser.h>
#include <commctrl.h>
#include "resource.h"

#ifndef NO_ICON
IDI_APP ICON "jigrack.ico"
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "jigrack.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Jig Rack"
            VALUE "ProductName", "Jig Rack"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "ProductVersion", "1.1.0.0"
            VALUE "OriginalFilename", "JigRack.exe"
            VALUE "InternalName", "JigRack"
            VALUE "LegalCopyright", "Copyright (C) 2026 Jon Raiford. GPL-3.0-or-later."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 320, 262
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT | WS_EX_APPWINDOW
CAPTION "Jig Rack Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TABS, "SysTabControl32", WS_TABSTOP, 7, 7, 306, 228
    DEFPUSHBUTTON   "Close", IDOK, 263, 241, 50, 14
END

IDD_PAGE_MOUSE DIALOGEX 0, 0, 296, 208
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Mouse &type:", -1, 7, 10, 50, 8
    COMBOBOX        IDC_MOUSE_TYPE, 60, 8, 150, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Mouse to show:", IDC_MOUSE_LISTLABEL, 7, 30, 200, 8
    LISTBOX         IDC_MOUSE_LIST, 7, 41, 282, 92, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "", IDC_MOUSE_STATUS, 7, 139, 224, 18
    PUSHBUTTON      "&Refresh", IDC_MOUSE_REFRESH, 239, 138, 50, 14
    AUTOCHECKBOX    "&Show the mouse battery meter in place of the Jig Rack icon", IDC_MOUSE_METER, 7, 164, 282, 10
    LTEXT           "&Low battery at or below:", IDC_MOUSE_LOWLABEL, 7, 185, 84, 8
    EDITTEXT        IDC_MOUSE_LOW, 92, 183, 24, 12, ES_NUMBER
    LTEXT           "%  (the meter turns red; hot corners can warn)", IDC_MOUSE_LOWNOTE, 120, 185, 170, 8
END

IDD_PAGE_CORNERS DIALOGEX 0, 0, 296, 208
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Rules:", -1, 7, 7, 100, 8
    LISTBOX         IDC_RULES, 7, 18, 248, 62, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "+", IDC_RULE_ADD, 261, 18, 28, 14
    PUSHBUTTON      "-", IDC_RULE_DEL, 261, 35, 28, 14
    GROUPBOX        "Selected rule", IDC_RULE_GROUP, 7, 84, 282, 120
    LTEXT           "&Corner:", -1, 15, 100, 52, 8
    COMBOBOX        IDC_RULE_CORNER, 72, 98, 110, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Where:", -1, 15, 118, 52, 8
    COMBOBOX        IDC_RULE_WHERE, 72, 116, 209, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Action:", -1, 15, 136, 52, 8
    COMBOBOX        IDC_RULE_ACTION, 72, 134, 110, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Co&mmand:", IDC_RULE_CMDLABEL, 15, 154, 52, 8
    EDITTEXT        IDC_RULE_COMMAND, 72, 152, 209, 12, ES_AUTOHSCROLL
    LTEXT           "&Delay (seconds):", -1, 15, 172, 56, 8
    EDITTEXT        IDC_RULE_DELAY, 72, 170, 36, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Show the c&ountdown", IDC_RULE_COUNTDOWN, 122, 171, 120, 10
    AUTOCHECKBOX    "Warn if the mouse &battery is low (set the level on the Mouse tab)", IDC_RULE_WARN, 15, 188, 266, 10
END
